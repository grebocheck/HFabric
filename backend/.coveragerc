[run]
branch = True
source = app
# GPU/ML adapter construction imports torch/onnxruntime and requires real model
# weights. It is validated by the hardware smoke matrix. Orchestration,
# generation callbacks, registry, video and memory-budget policy stay in scope.
omit =
    app/backends/image_diffusers.py
    app/backends/image_diffusers_parts/anima.py
    app/backends/image_diffusers_parts/anima_runtime.py
    app/backends/image_diffusers_parts/flux.py
    app/backends/image_diffusers_parts/flux2.py
    app/backends/image_diffusers_parts/memory.py
    app/backends/image_diffusers_parts/pipelines.py
    app/backends/image_diffusers_parts/qwen_z.py
    app/backends/image_diffusers_parts/sdxl.py
    app/backends/llm_llamacpp.py
    app/services/voice_engine/realtime.py
    app/services/voice_engine/rvc/*
    app/services/voice_engine/denoise.py
    app/services/voice_engine/pipeline.py
    app/services/voice_engine/onnx_cuda.py
    app/services/voice_engine/f0.py
    app/services/voice_engine/features.py

[report]
precision = 1
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == "__main__":
